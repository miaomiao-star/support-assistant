# OpenAI 兼容上游，填写其实际 API base URL（包含服务商要求的 /v1 等路径）
CHAT_API_KEY=replace_with_your_api_key
CHAT_BASE_URL=https://your-provider.example/v1
CHAT_MODEL=replace_with_your_model_name

EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# 输入上下文预算（system + 历史 + 当前消息），不是回复 token 上限
LLM_TOKEN_BUDGET=2000
# 中文字符估算系数；沿用原有 PRE 拼写
ZH_CHARS_PRE_TOKEN=1.2

# 工具协议与结果的输入总预算（字符估算），不是模型输出上限
TOOL_CONTEXT_BUDGET=8000
# 每次工具执行超时秒数；只读最多重试一次，写入不自动重试
TOOL_TIMEOUT_SECONDS=5
